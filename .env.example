# Copy to .env.development for local work and .env.production for the build.
# Neither is committed; this file is the only env file in git.

# Where the API is.
#   Local dev  : /backend/   (vite.config.js proxies it to the API, see there)
#   Production : https://rockdiet.app/backend/
VITE_API_URL=/backend/

# Firebase web client config, from the Firebase console. These are the
# browser-side keys and are not secret, but they are per-project, so they
# live in your own .env files rather than here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
