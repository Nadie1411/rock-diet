# Local development points at the live API through the dev-server proxy in
# vite.config.js, so the site runs on localhost against real data without
# tripping the API's CORS allow-list.
#
# To run a backend on your own machine instead, set this to that server's
# URL (e.g. http://localhost:3000/) and the proxy is bypassed.
VITE_API_URL=/backend/
